    "EventRuledocumentsToehrannotation": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Routes S3 events from documents to ehr-annotation",
        "State": "ENABLED",
        "EventPattern": {
          "source": [
            "aws.s3"
          ],
          "detail-type": [
            "Object Created"
          ],
          "detail": {
            "bucket": {
              "name": [
                {
                  "Ref": "Bucketdocuments"
