    "AlarmEhrLambdaTrafficAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Triggers kill switch if Lambda invocations exceed DDoS threshold",
        "EvaluationPeriods": 1,
        "Threshold": 2000,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "AlarmActions": [
          {
            "Ref": "Topicehrkillswitch"
          }
        ],
        "MetricName": "Invocations",
        "Namespace": "AWS/Lambda",
        "Period": 60,
        "Statistic": "Sum",
